# The System One server that makes the choices (a Decisio server, or any server with that wire format). No key.
SYSTEMONE_BASE_URL=http://127.0.0.1:8100
# SYSTEMONE_MODEL=            # only if the server needs a model name
# For a server that takes 2 to 26 options and text descriptions only (the Ollama listing):
# SYSTEMONE_STRING_DESCRIPTIONS=1
# SYSTEMONE_SKIP_SINGLE_OPTION=1
# The small text model that writes field values for TYPE_TEXT: any OpenAI-compatible server, local by default.
TEXT_MODEL_BASE_URL=http://127.0.0.1:8200/v1
TEXT_MODEL=
TEXT_MODEL_EXTRA_JSON={"chat_template_kwargs": {"enable_thinking": false}}
# browser-harness reports anonymous usage and checks for updates unless these are off:
BH_TELEMETRY=0
BH_UPDATE_CHECK=0

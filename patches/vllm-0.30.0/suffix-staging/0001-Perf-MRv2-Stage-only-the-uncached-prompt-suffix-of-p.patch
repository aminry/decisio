+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Suffix-only prompt staging for Model Runner V2 (opt-in via
+``VLLM_SUFFIX_STAGING=1``).
+
+When a new request is added to the runner, its prefill token ids (and, for
+M-RoPE models, its prefill positions) are staged into persistent per-request
+rows (``RequestState.all_token_ids`` / ``RopeState.prefill_positions``). By
+default the whole prefill is staged, even when a prefix-cache hit means only
+the positions ``>= num_computed_tokens`` will ever be run.
+
+With suffix-only staging, only ``prefill_token_ids[stage_start:]`` is written,
+at column offset ``stage_start`` of the same row, so every position
+``p >= stage_start`` holds exactly the value it would hold with full staging
+and no index translation is needed anywhere. Columns ``[0, stage_start)`` keep
+stale contents from an earlier occupant of the row.
+
+This is only correct if nothing reads columns ``< stage_start`` of the row for
+the lifetime of the request's slot. The prefill gather and the M-RoPE position
+gather read from the GPU ``num_computed_tokens`` of the slot, which is set to
+``num_computed_tokens`` at add time and only ever grows afterwards; preemption
+removes the slot and re-adds the request as a new request with its full
+prefill, so ``stage_start`` is recomputed then. The remaining readers of the
+prompt columns are request features (see ``request_needs_full_prompt``) and
+runner-wide features (checked by the model runner at load time); if any of
+them is active the full prompt is staged exactly as before.
+
+This module intentionally has no heavy imports so the predicate can be unit
+tested without torch.
+"""
+
+from typing import Any
+
+
+def request_needs_full_prompt(sampling_params: Any | None) -> bool:
+    """Whether a per-request feature reads staged prompt ids before
+    ``num_computed_tokens``.
+
+    Readers of ``RequestState.all_token_ids`` columns below
+    ``num_computed_tokens`` that are enabled per request:
+      - penalties: ``PenaltiesState.apply_staged_writes`` bincounts the whole
+        prefill (``[0, prefill_len)``).
+      - prompt logprobs: ``PromptLogprobsWorker`` reads prompt targets.
+      - thinking budget: ``ThinkingBudgetState`` scans from column 0 for
+        reasoning start/end tokens.
+    Conservatively also treated as needing the full prompt (no reader of the
+    prompt columns found in the runner, but cheap to exclude):
+      - bad words (the kernel reads output columns only),
+      - structured outputs (the grammar runs in the scheduler),
+      - pooling requests (``sampling_params is None``).
+    """
+    if sampling_params is None:
+        return True
+    return bool(
+        sampling_params.prompt_logprobs is not None
+        or sampling_params.repetition_penalty != 1.0
+        or sampling_params.frequency_penalty != 0.0
+        or sampling_params.presence_penalty != 0.0
+        or sampling_params.bad_words_token_ids
+        or sampling_params.structured_outputs is not None
+        or sampling_params.thinking_token_budget is not None
+    )
+
+
+def get_prompt_stage_start(
+    enabled: bool,
+    sampling_params: Any | None,
+    num_computed_tokens: int,
+    prefill_len: int,
+) -> int:
+    """First column of the prefill to stage for a newly added request.
+
+    Returns 0 (stage the full prefill, the default behavior) unless suffix
+    staging is enabled for the runner, the request has a prefix-cache hit and
+    no per-request feature needs the prompt. The result is clamped to
+    ``prefill_len`` so the staged slice is never out of range.
+    """
+    if not enabled or num_computed_tokens <= 0:
+        return 0
+    if request_needs_full_prompt(sampling_params):
+        return 0
+    return min(num_computed_tokens, prefill_len)

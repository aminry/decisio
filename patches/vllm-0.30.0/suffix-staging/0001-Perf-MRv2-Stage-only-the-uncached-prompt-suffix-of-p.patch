+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Tests for Model Runner V2 suffix-only prompt staging (VLLM_SUFFIX_STAGING).
+
+The predicate and the row-offset simulation are pure Python. The last test
+runs the real RequestState staging and prefill gather kernel on CUDA and is
+skipped elsewhere.
+"""
+
+from types import SimpleNamespace
+
+import pytest
+
+from vllm.v1.worker.gpu.suffix_staging import (
+    get_prompt_stage_start,
+    request_needs_full_prompt,
+)
+
+
+def _params(**overrides) -> SimpleNamespace:
+    """Stand-in for SamplingParams with the defaults of the audited fields."""
+    fields = dict(
+        prompt_logprobs=None,
+        repetition_penalty=1.0,
+        frequency_penalty=0.0,
+        presence_penalty=0.0,
+        bad_words_token_ids=None,
+        structured_outputs=None,
+        thinking_token_budget=None,
+    )
+    fields.update(overrides)
+    return SimpleNamespace(**fields)
+
+
+def test_default_request_does_not_need_full_prompt():
+    assert not request_needs_full_prompt(_params())
+    # Empty bad words list is the post-tokenization default.
+    assert not request_needs_full_prompt(_params(bad_words_token_ids=[]))
+
+
+@pytest.mark.parametrize(
+    "overrides",
+    [
+        dict(prompt_logprobs=0),
+        dict(prompt_logprobs=5),
+        dict(repetition_penalty=1.1),
+        dict(frequency_penalty=0.5),
+        dict(presence_penalty=-0.5),
+        dict(bad_words_token_ids=[[1, 2]]),
+        dict(structured_outputs=object()),
+        dict(thinking_token_budget=0),
+        dict(thinking_token_budget=128),
+    ],
+)
+def test_prompt_reading_features_need_full_prompt(overrides):
+    assert request_needs_full_prompt(_params(**overrides))
+
+
+def test_pooling_request_needs_full_prompt():
+    assert request_needs_full_prompt(None)
+
+
+def test_real_sampling_params_defaults():
+    sampling_params = pytest.importorskip("vllm.sampling_params")
+    sp = sampling_params.SamplingParams(
+        max_tokens=1, temperature=0.0, logprobs=5, allowed_token_ids=[3, 4]
+    )
+    assert not request_needs_full_prompt(sp)
+    assert request_needs_full_prompt(
+        sampling_params.SamplingParams(max_tokens=1, presence_penalty=0.1)
+    )
+    assert request_needs_full_prompt(
+        sampling_params.SamplingParams(max_tokens=1, prompt_logprobs=1)
+    )
+    assert request_needs_full_prompt(
+        sampling_params.SamplingParams(max_tokens=1, _bad_words_token_ids=[[1]])
+    )
+
+
+@pytest.mark.parametrize(
+    "enabled,params,num_computed,prefill_len,expected",
+    [
+        (False, _params(), 8000, 8300, 0),  # disabled
+        (True, _params(), 0, 8300, 0),  # no prefix-cache hit
+        (True, _params(), 8000, 8300, 8000),  # prefix-cache hit
+        (True, _params(), 8299, 8300, 8299),  # only the last token uncached
+        (True, _params(), 9000, 8300, 8300),  # clamped to the prefill
+        (True, _params(presence_penalty=1.0), 8000, 8300, 0),  # needs prompt
+        (True, None, 8000, 8300, 0),  # pooling
+    ],
+)
+def test_get_prompt_stage_start(enabled, params, num_computed, prefill_len, expected):
+    assert (
+        get_prompt_stage_start(enabled, params, num_computed, prefill_len) == expected
+    )
+
+
+def _simulate_prefill_reads(
+    prefill: list[int],
+    num_computed: int,
+    stage_start: int,
+    chunk: int,
+    lookahead: int,
+    max_model_len: int,
+) -> list[tuple[list[int], list[int]]]:
+    """Pure-Python model of RequestState.add_request (staged row write at column
+    stage_start of a row with stale contents) followed by chunked
+    _prepare_prefill_inputs_kernel reads (query tokens from column
+    num_computed plus lookahead tokens below prefill_len)."""
+    row = [-7] * max_model_len  # stale data from a previous occupant
+    row[stage_start : len(prefill)] = prefill[stage_start:]
+    reads = []
+    pos = num_computed
+    while pos < len(prefill):
+        q = min(chunk, len(prefill) - pos)
+        tokens = row[pos : pos + q]
+        nxt = [
+            row[p] if p < len(prefill) else 0
+            for p in range(pos + q, pos + q + lookahead)
+        ]
+        reads.append((tokens, nxt))
+        pos += q
+    return reads
+
+
+@pytest.mark.parametrize("num_computed", [0, 1, 255, 256, 500, 7999, 8000, 8299])
+@pytest.mark.parametrize("chunk", [1, 64, 8192])
+def test_suffix_row_offsets_preserve_every_read(num_computed, chunk):
+    prefill = [1000 + i for i in range(8300)]
+    stage_start = get_prompt_stage_start(True, _params(), num_computed, len(prefill))
+    full = _simulate_prefill_reads(prefill, num_computed, 0, chunk, 2, 8448)
+    suffix = _simulate_prefill_reads(prefill, num_computed, stage_start, chunk, 2, 8448)
+    assert suffix == full
+    # And the model sees exactly the uncached prompt suffix, in order.
+    assert [t for tokens, _ in suffix for t in tokens] == prefill[num_computed:]
+
+
+@pytest.mark.parametrize("num_computed", [0, 1, 17, 1023, 1024, 1500, 1599])
+def test_cuda_suffix_staging_prefill_gather_matches_full(num_computed):
+    torch = pytest.importorskip("torch")
+    pytest.importorskip("triton")
+    if not torch.cuda.is_available():
+        pytest.skip("CUDA required for the Model Runner V2 gather kernel")
+    from vllm.v1.worker.gpu.input_batch import prepare_prefill_inputs
+    from vllm.v1.worker.gpu.states import RequestState
+
+    device = torch.device("cuda")
+    prefill_len = 1600
+    prefill = [1000 + i for i in range(prefill_len)]
+    chunk = 256
+
+    def run(stage_start: int) -> list[tuple[list[int], list[int]]]:
+        req_states = RequestState(
+            max_num_reqs=2,
+            max_model_len=2048,
+            max_num_batched_tokens=chunk,
+            num_speculative_steps=0,
+            vocab_size=4096,
+            device=device,
+            num_prefill_lookahead=2,
+        )
+        # Leave stale token ids in the slot the request will reuse.
+        req_states.add_request(
+            req_id="old",
+            prompt_len=prefill_len,
+            all_token_ids=[7] * prefill_len,
+            num_computed_tokens=0,
+            max_tokens=1,
+        )
+        req_states.apply_staged_writes()
+        old_idx = req_states.remove_request("old")
+
+        req_states.add_request(
+            req_id="req",
+            prompt_len=prefill_len,
+            all_token_ids=prefill,
+            num_computed_tokens=num_computed,
+            max_tokens=1,
+            stage_start=stage_start,
+        )
+        req_states.apply_staged_writes()
+        req_idx = req_states.req_id_to_index["req"]
+        assert req_idx == old_idx
+
+        idx_mapping = torch.tensor([req_idx], dtype=torch.int32, device=device)
+        reads = []
+        pos = num_computed
+        while pos < prefill_len:
+            q = min(chunk, prefill_len - pos)
+            input_ids = torch.zeros(q, dtype=torch.int32, device=device)
+            query_start_loc = torch.tensor([0, q], dtype=torch.int32, device=device)
+            prepare_prefill_inputs(
+                input_ids,
+                req_states.next_prefill_tokens,
+                idx_mapping,
+                query_start_loc,
+                req_states.all_token_ids.gpu,
+                req_states.prefill_len.gpu,
+                req_states.num_computed_tokens.gpu,
+            )
+            reads.append(
+                (
+                    input_ids.cpu().tolist(),
+                    req_states.next_prefill_tokens[:, req_idx].cpu().tolist(),
+                )
+            )
+            # Advance the GPU num_computed_tokens as post_update() would.
+            req_states.num_computed_tokens.gpu[req_idx] += q
+            pos += q
+        return reads
+
+    stage_start = get_prompt_stage_start(True, _params(), num_computed, prefill_len)
+    assert stage_start == num_computed
+    full = run(0)
+    suffix = run(stage_start)
+    assert suffix == full
+    assert [t for tokens, _ in suffix for t in tokens] == prefill[num_computed:]

+    def _init_suffix_staging(self) -> bool:
+        """Whether suffix-only prompt staging may be used by this runner.
+
+        Besides per-request features (suffix_staging.request_needs_full_prompt),
+        these runner-wide components read staged prompt ids or M-RoPE positions
+        before num_computed_tokens, or are not audited, so any of them disables
+        the feature:
+          - model states other than DefaultModelState / MambaHybridModelState
+            (model-provided states such as n-gram context builders read
+            all_token_ids before num_computed_tokens),
+          - the EVS multimodal pruner (reads all_token_ids[:prefill_len] and
+            the prefill positions from column 0),
+          - watermarking (hashes committed context tokens),
+          - speculative decoding, pooling models, custom logits processors
+            (conservative).
+        """
+        if not self._suffix_staging_requested:
+            return False
+        from vllm.v1.worker.gpu.model_states.default import DefaultModelState
+        from vllm.v1.worker.gpu.model_states.mamba_hybrid import (
+            MambaHybridModelState,
+        )
+
+        reasons: list[str] = []
+        if type(self.model_state) not in (DefaultModelState, MambaHybridModelState):
+            reasons.append(f"model state {type(self.model_state).__name__}")
+        if getattr(self.model_state, "mm_pruner", None) is not None:
+            reasons.append("multimodal embedding pruning")
+        if self.vllm_config.watermark_config is not None:
+            reasons.append("watermarking")
+        if self.speculative_config is not None:
+            reasons.append("speculative decoding")
+        if self.is_pooling_model:
+            reasons.append("pooling model")
+        if self.model_config.logits_processors:
+            reasons.append("custom logits processors")
+        if reasons:
+            logger.warning(
+                "VLLM_SUFFIX_STAGING=1 ignored: not supported with %s.",
+                ", ".join(reasons),
+            )
+            return False
+        logger.info(
+            "VLLM_SUFFIX_STAGING=1: staging only the uncached prompt suffix "
+            "of new requests with a prefix-cache hit."
+        )
+        return True
 
     def get_model(self) -> nn.Module:
         return self.model

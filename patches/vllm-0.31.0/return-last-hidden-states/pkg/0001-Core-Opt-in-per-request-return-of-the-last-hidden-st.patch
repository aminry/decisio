+        return {
+            req_id: hidden_states[
+                input_batch.logits_indices[cu_num_logits[i] : cu_num_logits[i + 1]]
+            ]
+            for i, req_id in enumerate(input_batch.req_ids)
+            if req_id in self.last_hidden_states_req_ids
+        }
+
